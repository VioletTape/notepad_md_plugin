#include "res/resource.h"
#include <winres.h>

IDI_PREVIEW   ICON    "nmd.ico"
IDR_SHIKI_JS  RCDATA  "res/shiki.bundle.js"
IDR_ONIG_WASM RCDATA  "res/onig.wasm"
IDR_NMD_HTML  RCDATA  "res/nmd.html"
IDR_MERMAID_JS RCDATA  "res/mermaid.min.js"

VS_VERSION_INFO VERSIONINFO
FILEVERSION        1,0,0,0
PRODUCTVERSION     1,0,0,0
FILEFLAGSMASK      VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS          VS_FF_DEBUG
#else
FILEFLAGS          0x0L
#endif
FILEOS             VOS_NT_WINDOWS32
FILETYPE           VFT_DLL
FILESUBTYPE        VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "VioletTape"
            VALUE "FileDescription",  "NMD - Notepad++ Markdown Preview"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "NMD.dll"
            VALUE "LegalCopyright",   "Copyright (C) 2026 VioletTape"
            VALUE "OriginalFilename", "NMD.dll"
            VALUE "ProductName",      "NMD"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

